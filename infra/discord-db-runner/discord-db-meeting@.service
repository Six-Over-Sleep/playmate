[Unit]
Description=PlayMate Discord meeting %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=playmate
Group=playmate
WorkingDirectory=/opt/playmate/playmate-discord-bot
EnvironmentFile=/etc/playmate/discord-db-meeting.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/playmate/venv/bin/python -m db_runner meeting-%i
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=10
TimeoutStopSec=180
StateDirectory=discord-db-runner
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
