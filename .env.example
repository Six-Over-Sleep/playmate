# PostgreSQL shared by the board API and meetup API. Fill these locally; do not
# commit real credentials.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=require

# Backend
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API and development-only board authentication
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEV_MEMBER_ID=
