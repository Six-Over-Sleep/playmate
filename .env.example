# PostgreSQL shared by the board API and meetup API. Fill these locally; do not
# commit real credentials.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=require

# Backend
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API and development-only board authentication
# 기존 모임 코드가 사용 중인 값. 담당자가 공통 모듈로 전환하기 전까지 유지합니다.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEV_MEMBER_ID=

# 공통 프론트엔드 설정: 로컬은 빈 값, 별도 서버는 https://api.example.com (/api 제외)
VITE_BACKEND_ORIGIN=
# 로컬 개발용 프록시 대상. 브라우저에 노출할 필요가 없어 VITE_를 붙이지 않습니다.
BACKEND_PROXY_TARGET=http://localhost:8000
