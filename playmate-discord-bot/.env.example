# 디스코드 봇 토큰 (절대 외부에 공유 금지)
DISCORD_BOT_TOKEN=
# 디스코드 서버 ID
DISCORD_GUILD_ID=

# 테스트 모드: true면 1분마다 검사, false면 하루 1번 (운영은 false)
PLAYMATE_TEST_MODE=false

# 공용 DB 접속 정보 (백엔드와 같은 값). 비워두면 DB 없이 실행돼요.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=

# DB와 디스코드를 맞추는 주기(초). 비우면 10초
PLAYMATE_SYNC_INTERVAL_SECONDS=

# ---- 아래는 선택 사항. 비워두면 그 기능만 꺼져요. ----
# /게시글추천 명령을 쓸 수 있는 운영자 역할 ID
PLAYMATE_ADMIN_ROLE_ID=
# #핫플레이메이트, #취업-소식 채널 ID
# #취업-소식: 매일 18:00 취준 도감·커리어 연구소 신규 글 자동 공지 (하루 최대 5개, DB 013 마이그레이션 필요)
PLAYMATE_HOT_CHANNEL_ID=
PLAYMATE_CAREER_CHANNEL_ID=
# PlayMate 웹 주소. /게시글추천 Embed에 게시글 상세 링크를 붙여요 (예: https://playmate.example.com)
# 비우면 링크 없이 게시하고, localhost는 PLAYMATE_TEST_MODE=true일 때만 써요.
PLAYMATE_WEB_BASE_URL=
