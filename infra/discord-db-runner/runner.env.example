# Safe defaults: neither command constructs AWS/DB clients until opted in.
DB_RUNNER_CAREER_ENABLED=false
DB_RUNNER_HOT_ENABLED=false
DB_RUNNER_DM_ENABLED=false
DB_RUNNER_DM_MODE=disabled
DB_RUNNER_DIGEST_GRACE_MINUTES=30
DB_RUNNER_WAIT_SECONDS=20
DB_RUNNER_READ_TIMEOUT_SECONDS=30
DB_RUNNER_VISIBILITY_SECONDS=360
DB_RUNNER_HEARTBEAT_SECONDS=60
DB_RUNNER_LOCK_DIR=/var/lib/discord-db-runner
PLAYMATE_ENVIRONMENT=test
AWS_DEFAULT_REGION=ap-northeast-2
# Fill outside Git; no AWS access keys or Discord token belongs here.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=require
PLAYMATE_WEB_BASE_URL=
CAREER_SHARE_CUTOVER_AT=
CAREER_SHARE_SEND_QUEUE_URL=
CAREER_SHARE_RESULT_QUEUE_URL=
HOT_SHARE_DB_TIMEZONE=
HOT_SHARE_SEND_QUEUE_URL=
HOT_SHARE_RESULT_QUEUE_URL=
DM_SHARE_SEND_QUEUE_URL=
DM_SHARE_RESULT_QUEUE_URL=
