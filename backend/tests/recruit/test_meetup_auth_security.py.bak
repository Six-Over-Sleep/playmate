"""Discord OAuth 세션 기반 회원 인증. 개발용 회원 헤더는 사용하지 않습니다."""

from fastapi import HTTPException, Request

from .db_connect import db_cursor


def get_current_member_id(request: Request) -> int:
    """서명된 세션의 회원 ID·Discord ID를 현재 활성 회원과 대조합니다."""
    member_id = request.session.get("member_id")
    user = request.session.get("user")

    if member_id is None:
        raise HTTPException(status_code=401, detail="로그인이 필요합니다.")
    if (
        type(member_id) is not int
        or not isinstance(user, dict)
        or not user.get("discord_id")
    ):
        raise HTTPException(status_code=401, detail="유효하지 않은 로그인 세션입니다.")

    with db_cursor(read_only=True) as cursor:
        cursor.execute(
            """
            SELECT 1
            FROM members
            WHERE member_id = %s
              AND discord_id = %s
              AND member_status = 'ACTIVE'
            """,
            (member_id, str(user["discord_id"])),
        )
        if cursor.fetchone() is None:
            raise HTTPException(status_code=401, detail="유효하지 않은 로그인 세션입니다.")

    return member_id
