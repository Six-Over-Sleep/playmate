[Unit]
Description=PlayMate Discord DB result consumers
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=playmate
Group=playmate
WorkingDirectory=/opt/playmate/playmate-discord-bot
EnvironmentFile=/etc/playmate/discord-db-runner.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/playmate/venv/bin/python -m db_runner results
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=180
StateDirectory=discord-db-runner
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
