# ==============================
# Application
# ==============================

APP_ENV=development

# ==============================
# Database
# ==============================

DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=require

# ==============================
# CORS / Frontend
# ==============================

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================
# Frontend API
# ==============================

# 기존 모임 API 코드용
# 공통 apiRequest 적용 완료 후 제거 가능
VITE_API_BASE_URL=http://localhost:8000/api

# 개발용 회원 인증
VITE_DEV_MEMBER_ID=-1

# 공통 API 설정
# 로컬 개발에서는 비워둠
VITE_BACKEND_ORIGIN=

# Vite proxy가 연결할 FastAPI 주소
BACKEND_PROXY_TARGET=http://localhost:8000

# ==============================
# Kakao Maps
# ==============================

VITE_KAKAO_MAP_KEY=

# ==============================
# Discord OAuth2
# ==============================

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback

# ==============================
# Login Session
# ==============================

SESSION_SECRET_KEY=