DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# true: test every 60 seconds; false: production once every 24 hours.
PLAYMATE_TEST_MODE=false

# Shared PostgreSQL (same names as the backend). When unset the Bot falls back
# to the in-memory repository and does not sync with the PlayMate DB.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=

# Seconds between DB <-> Discord reconciliations (default 10).
PLAYMATE_SYNC_INTERVAL_SECONDS=
